# ========================================================
# CHUNNA ACCESORIOS - PLANTILLA DE VARIABLES DE ENTORNO
# ========================================================
# ⚠️ IMPORTANTE: NUNCA subas archivos .env a GitHub.
# En Render, estas variables se configuran en el panel:
# Dashboard -> Tu Web Service -> Environment -> Add Environment Variable
# ========================================================

# 1. ENTORNO Y SEGURIDAD
NODE_ENV=production
JWT_SECRET=tu_clave_secreta_jwt_larga_y_segura_aqui_2026
ADMIN_EMAIL=chunna.accs@gmail.com

# 2. BASE DE DATOS MYSQL (Aiven, Railway, TiDB Cloud, Clever Cloud, etc.)
# Opción A (Recomendado): URL de conexión completa proporcionada por tu proveedor
DATABASE_URL=mysql://usuario:password@host-de-tu-db.com:3306/defaultdb

# Opción B: Credenciales individuales (si no usas DATABASE_URL)
# DB_HOST=tu-host.com
# DB_PORT=3306
# DB_USER=tu-usuario
# DB_PASSWORD=tu-password
# DB_NAME=chunna_db
# DB_SSL=true

# 3. INTELIGENCIA ARTIFICIAL (Google Gemini AI Studio)
# Obtén tu clave gratis en https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-1.5-flash

# 4. INTEGRACIÓN META / INSTAGRAM (Opcional)
META_VERIFY_TOKEN=chunna_meta_webhook_token_2026
PAGE_ACCESS_TOKEN=tu_token_de_meta_o_instagram

