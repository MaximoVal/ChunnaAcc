# Configuración del servidor
PORT=5000

# Configuración de base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=chunna_db

# Clave de API de Google Gemini (Opcional - para análisis y autocompletado de imágenes con IA)
GEMINI_API_KEY=tu_api_key_de_gemini

# Configuración de Meta Webhook (Instagram Graph API)
META_VERIFY_TOKEN=tu_token_de_verificacion_para_meta_webhooks
PAGE_ACCESS_TOKEN=tu_page_access_token_de_la_api_graph_de_meta
