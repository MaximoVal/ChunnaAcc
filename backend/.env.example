# ========================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA BACKEND (RENDER)
# Copia estas variables en la sección "Environment" de tu Web Service en Render
# ========================================================

# Puerto del servidor (Render lo asigna dinámicamente, NO es necesario fijarlo en Render)
PORT=5000
NODE_ENV=production

# Clave secreta para la firma de tokens JWT (Usa un string largo y aleatorio)
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui_2026

# Email del administrador principal
ADMIN_EMAIL=cunna.accs@gmail.com

# --------------------------------------------------------
# CONEXIÓN A BASE DE DATOS MYSQL (Aiven, PlanetScale, Railway, Supabase, etc.)
# --------------------------------------------------------
# Opción A: URL completa de conexión (Recomendado si tu proveedor te da un string mysql://)
# DATABASE_URL=mysql://usuario:password@host.de.tu.db:3306/chunna_db

# Opción B: Credenciales individuales
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_db
DB_NAME=chunna_db
DB_SSL=false

# --------------------------------------------------------
# INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI AI STUDIO)
# Obtén tu clave en https://aistudio.google.com/
# --------------------------------------------------------
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------
# INTEGRACIÓN META / INSTAGRAM GRAPH API
# --------------------------------------------------------
META_VERIFY_TOKEN=chunna_meta_webhook_token_2026
PAGE_ACCESS_TOKEN=tu_page_access_token

# --------------------------------------------------------
# CONFIGURACIÓN DE ORIGEN FRONTEND (CORS)
# Si despliegas el Frontend de forma independiente en un Render Static Site:
# --------------------------------------------------------
# FRONTEND_URL=https://tu-sitio-frontend.onrender.com
